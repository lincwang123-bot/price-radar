{
  "_说明": "可选模板：默认即可运行。如需覆盖默认配置，复制本文件为 config.json 后按需修改（写 null/缺省即用内置默认）。",
  "sources": {
    "ldxp-goods": {
      "enabled": true,
      "label": "RelayWatch·链动小铺(LDXP) 卡网商品价",
      "_说明": "keywords 为 null 时继承已核验的默认关键词名单，随内置名单更新。",
      "keywords": null,
      "min_interval_minutes": 30,
      "page_size": 100,
      "max_pages_per_keyword": 2,
      "max_requests": 24,
      "request_delay_ms": 1000
    },
    "direct-shops": {
      "discovery": {
        "platform16688": true
      },
      "enabled": true,
      "label": "原始店铺直采",
      "min_interval_minutes": 30,
      "request_delay_ms": 500,
      "_说明": "targets 为 null 时继承已核验的默认原店名单，随内置名单更新。",
      "targets": null
    }
  },
  "watch": {
    "rules": [
      {
        "id": "chatgpt-plus-recharge-below-105",
        "kind": "min_below",
        "source": "direct-shops",
        "product": "chatgpt-plus-recharge",
        "threshold": 105,
        "term": "1m",
        "currency": "CNY"
      },
      {
        "id": "ldxp-gpt-pro-below-80",
        "kind": "min_below",
        "source": "ldxp-goods",
        "product": "gpt-pro",
        "threshold": 80
      },
      {
        "id": "chatgpt-any-drop-8pct",
        "kind": "drop_pct",
        "source": "direct-shops",
        "product": "*",
        "window": 24,
        "pct": 8
      },
      {
        "id": "plus-cheapest-moved",
        "kind": "cheapest_changed",
        "source": "direct-shops",
        "product": "chatgpt-plus-recharge"
      },
      {
        "id": "plus-cheapest-gone",
        "kind": "offer_gone",
        "source": "direct-shops",
        "product": "chatgpt-plus-recharge"
      }
    ]
  },
  "offerRetention": {
    "_说明": "主库 offers 瘦身。enabled 打开后，采集进程在上海时间 2:00–5:00 把超出 days 的明细滚成 K 线并清理。candleHours 默认 4，桶起点是上海时间 0/4/8/12/16/20 点。dedupe 打开后，热窗口（至少 160 个快照）之外价格和库存相同的报价不再保留新行。两者默认关闭。quietHourStart 与 quietHourEnd 相等（例如都是 2）时采集侧不进入滚动窗口，仅由 timer 执行 retain-offers。batchSnapshots 为每批删除快照数；maxDeleteBatches 为删除批数上限；maxRollSnapshots 为滚动快照上限；busyTimeout 为锁等待毫秒数；maxRuntimeMs 为批次边界运行时长上限（毫秒）；dedupeSnapshots 为 timer 去重快照总上限。archiveDir 请指到有空间的挂载卷；不要在只剩数 GB 的系统盘上 VACUUM。",
    "enabled": false,
    "dedupe": false,
    "days": 30,
    "candleHours": 4,
    "protectSnapshots": 160,
    "quietHourStart": 2,
    "quietHourEnd": 5,
    "batchSnapshots": 20,
    "maxDeleteBatches": 40,
    "maxRollSnapshots": 400,
    "busyTimeout": 10000,
    "maxRuntimeMs": 2400000,
    "dedupeSnapshots": 4,
    "archiveDir": null,
    "allowUnarchivedDelete": false
  },
  "notify": {
    "console": true,
    "logFile": true,
    "webhooks": []
  }
}
